{
  "name": "door-control-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "build": "npm install",
    "generate-url": "node scripts/generate-access-url.js",
    "notify-attendees": "node scripts/notify-attendees.js",
    "send-test-email": "node scripts/send-test-email.js",
    "cron": "node scripts/send-event-access-emails.js",
    "test:cron": "DRY_RUN=true node scripts/send-event-access-emails.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:signature": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/signature-auth.test.js",
    "test:discord": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/discord-access.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/discord-integration.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": ["**/*.test.js"]
  },
  "dependencies": {
    "@citizenwallet/sdk": "^2.0.130",
    "@discordjs/rest": "^2.6.1",
    "discord-api-types": "^0.37.120",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "express": "^4.22.2",
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2"
  }
}
